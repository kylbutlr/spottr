{
  "name": "spottr",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Local-first Chrome extension for screenshot-backed frontend QA notes.",
  "scripts": {
    "build": "npm run check && npm test && node scripts/package.mjs",
    "check": "node scripts/check.mjs",
    "package": "node scripts/package.mjs",
    "test": "npm run styles:check && node --test --test-concurrency=1 test/*.test.mjs",
    "styles": "node scripts/sync-app-stylr.mjs",
    "styles:check": "node scripts/sync-app-stylr.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "app-stylr": "file:vendor/packages/app-stylr-1.4.1.tgz"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
