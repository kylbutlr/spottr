{
  "manifest_version": 3,
  "name": "Spottr",
  "short_name": "Spottr",
  "version": "0.2.0",
  "minimum_chrome_version": "102",
  "description": "Capture reproducible visual QA notes with local screenshots and JSON export. No account required.",
  "icons": {
    "16": "icons/chrome/icon-16.png",
    "32": "icons/chrome/icon-32.png",
    "48": "icons/chrome/icon-48.png",
    "128": "icons/chrome/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/Geist-Variable.woff2",
        "fonts/GeistMono-Variable.woff2"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/chrome/icon-16.png",
      "32": "icons/chrome/icon-32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Spottr"
  },
  "options_page": "options.html",
  "commands": {
    "capture-qa-note": {
      "description": "Capture an area for a QA note"
    },
    "add-qa-note": {
      "description": "Add a QA note without a screenshot"
    }
  }
}
